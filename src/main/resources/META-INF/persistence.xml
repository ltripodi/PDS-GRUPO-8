<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="skillSwapPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- El mapeo esta en orm.xml: el dominio no tiene anotaciones JPA (Clean Architecture, seccion 6). -->
        <mapping-file>META-INF/orm.xml</mapping-file>

        <class>com.skillswap.domain.perfil.Habilidad</class>
        <class>com.skillswap.domain.publicacion.Categoria</class>
        <class>com.skillswap.domain.publicacion.Organizacion</class>
        <class>com.skillswap.domain.publicacion.Publicacion</class>
        <class>com.skillswap.domain.publicacion.FranjaHoraria</class>
        <class>com.skillswap.domain.contratacion.Solicitud</class>
        <class>com.skillswap.domain.contratacion.Reserva</class>
        <class>com.skillswap.domain.contratacion.PropuestaReprogramacion</class>
        <class>com.skillswap.domain.pagos.Billetera</class>
        <class>com.skillswap.domain.pagos.Movimiento</class>
        <class>com.skillswap.domain.pagos.Pago</class>
        <class>com.skillswap.domain.calificacion.Calificacion</class>
        <class>com.skillswap.domain.notificacion.Notificacion</class>
        <class>com.skillswap.domain.precio.Promocion</class>
        <class>com.skillswap.domain.perfil.Perfil</class>
        <class>com.skillswap.domain.contratacion.Contratacion</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <!-- La base se crea sola si no existe. Usuario/clave por defecto root/root: cada integrante los pisa
                 sin editar este archivo con -Djakarta.persistence.jdbc.user=... y -Djakarta.persistence.jdbc.password=... -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/skillswap?createDatabaseIfNotExist=true&amp;serverTimezone=UTC"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="root"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQLDialect"/>

            <!-- El esquema lo crea Flyway (db/migration), no Hibernate. Ver MigracionesBaseDeDatos. -->
            <property name="hibernate.hbm2ddl.auto"
                      value="none"/>

            <!-- Evita N+1: las colecciones de varias entidades se cargan en lotes (consigna, seccion 8). -->
            <property name="hibernate.default_batch_fetch_size"
                      value="50"/>

            <!-- Apagado para que la consola de la demo sea legible. Para ver el SQL: -Dhibernate.show_sql=true -->
            <property name="hibernate.show_sql"
                      value="false"/>

            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>

    </persistence-unit>

</persistence>
